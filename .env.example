# Ornek ortam degiskenleri — kopyasi .env.local olarak olusturulur.
# EasyPanel'de bu degerler servis ortam degiskeni olarak tanimlanir.

# Postgres baglantisi (docker-compose.yml ile birebir uyumlu)
DATABASE_URL=postgres://manifest:manifest@localhost:5432/manifest

# Admin paneli giris sifresi
ADMIN_PASSWORD=manifest-admin

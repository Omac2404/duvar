# Ornek ortam degiskenleri — kopyasi .env.local olarak olusturulur.
# EasyPanel'de tek gereken degisken DATABASE_URL'dir (servis env'i).

# Postgres baglantisi (lokalde docker'daki manifest-db konteyneri;
# EasyPanel'de oradaki Postgres servisinin baglanti adresi)
DATABASE_URL=postgres://manifest:manifest@localhost:5432/manifest

# Not: Admin girisi artik ortam degiskeniyle degil admins tablosuyla
# calisir (super admin ilk acilista otomatik olusur). SMTP, Google girisi
# ve diger tum ayarlar admin panelinden yapilir ve veritabaninda tutulur.
